<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
    <id>${cmake.classifier}</id>
    <formats>
        <format>zip</format>
    </formats>
    <baseDirectory>/</baseDirectory>
    <includeBaseDirectory>true</includeBaseDirectory>

    <fileSets>
        <fileSet>
            <directory>${project.basedir}/${cmake.binary.dir}</directory>
            <includes>
                <include>cc1.exe</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/${cmake.binary.dir}</directory>
            <includes>
                <include>tasm.exe</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}</directory>
            <includes>
                <include>iserver*.c</include>
            </includes>
            <outputDirectory>examples/iserver-c</outputDirectory>
            <lineEnding>windows</lineEnding>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${project.basedir}/README.md</source>
            <outputDirectory>./</outputDirectory>
            <destName>README-transputer-k-r-c-compiler.md</destName>
            <lineEnding>windows</lineEnding>
        </file>
    </files>

</assembly>